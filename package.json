{
	"name": "@utily/worker-template",
	"version": "0.0.3",
	"description": "TypeScript template for stencil and Cloudflare workers.",
	"private": true,
	"repository": "https://github.com/worker-stencil-template/app/",
	"type": "module",
	"bugs": { "url": "https://github.com/worker-stencil-template/app/issues/" },
	"homepage": "https://github.com/worker-stencil-template/app/",
	"scripts": {
		"lint": "eslint '**/*.{ts,tsx}'",
		"fix": "eslint '**/*.{ts,tsx}' --fix",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"types": "wrangler types ./api/Cloudflare.d.ts --env-interface=Environment",
		"transpile": "tsc --build ./api/tsconfig.json -noEmit",
		"build": "npm run build:api && npm run build:ui",
		"build:api": "wrangler deploy --dry-run --outdir=dist",
		"build:ui": "stencil build",
		"start": "(npm run start:api) & (npm run start:ui) && kill $!",
		"start:api": "wrangler dev --live-reload --env local --inspector-port 9229",
		"start:ui": "stencil build --dev --serve --watch",
		"clean": "rimraf dist node_modules coverage",
		"kill": "(ps -aux | grep rollup | grep watch | awk '{print $2}' | xargs kill $1) & (lsof -i tcp:8787 | grep 8787 | awk '{print $2}' | xargs kill $1) & (lsof -i tcp:3333 | grep 3333 | awk '{print $2}' | xargs kill $1)"
	},
	"devDependencies": {
		"@stencil/core": "4.9.1",
		"@typescript-eslint/eslint-plugin": "6.18.1",
		"@typescript-eslint/parser": "6.18.1",
		"eslint": "8.56.0",
		"eslint-plugin-prettierx": "github:utily/eslint-plugin-prettierx#utily-20231004",
		"eslint-plugin-simple-import-sort": "10.0.0",
		"prettierx": "github:utily/prettierx#utily-20231004",
		"puppeteer": "21.7.0",
		"rimraf": "5.0.5",
		"vitest": "^3.1.4",
		"tslib": "2.8.1",
		"typescript": "5.8.3",
		"wrangler": "^4.16.1"
	},
	"dependencies": {
		"cloudly-http": "0.2.0-alpha.24",
		"cloudly-router": "1.0.1-alpha.6",
		"gracely": "2.0.11",
		"smoothly": "1.0.0-alpha.129"
	}
}
